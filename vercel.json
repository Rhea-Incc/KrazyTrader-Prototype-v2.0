{
  "installCommand": "corepack pnpm@12.16.1 install --frozen-lockfile",
  "buildCommand": "corepack pnpm@12.16.1 --filter @workspace/krazytrader run build",
  "outputDirectory": "artifacts/krazytrader/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/qr",
      "destination": "/qr.html"
    },
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/web",
      "destination": "/web.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/KrazyTrader.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=KrazyTrader.apk"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
